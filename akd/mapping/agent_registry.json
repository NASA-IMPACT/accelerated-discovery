{
  "version": "1.0.0",
  "created_at": "2024-09-10T12:00:00.000Z",
  "updated_at": "2024-09-10T12:00:00.000Z",
  "agents": {
    "query": {
      "agent_id": "query",
      "name": "Query Agent",
      "description": "Agent that generates search engine queries based on a given query.",
      "agent_class": "akd.agents.query.QueryAgent",
      "enabled": true,
      "input_schema": {
        "fields": [
          {
            "name": "query",
            "type": "string",
            "description": "A detailed query/instruction or request to generate search engine queries for.",
            "required": true
          },
          {
            "name": "num_queries", 
            "type": "integer",
            "description": "The number of search queries to generate.",
            "required": false,
            "default": 3
          }
        ]
      },
      "output_schema": {
        "fields": [
          {
            "name": "queries",
            "type": "array",
            "description": "List of search queries.",
            "required": true,
            "items_type": "string"
          },
          {
            "name": "category",
            "type": "string",
            "description": "Category of the search queries.",
            "required": false,
            "default": "science"
          }
        ]
      },
      "tags": ["query"],
      "use_cases": ["Agent that generates search engine queries based on a given query."],
      "dependencies": []
    },
    "extraction": {
      "agent_id": "extraction",
      "name": "Extraction Agent", 
      "description": "Agent for extracting structured information from text.",
      "agent_class": "akd.agents.extraction.EstimationExtractionAgent",
      "enabled": true,
      "input_schema": {
        "fields": [
          {
            "name": "text",
            "type": "string",
            "description": "Text to extract information from.",
            "required": true
          }
        ]
      },
      "output_schema": {
        "fields": [
          {
            "name": "extractions",
            "type": "array",
            "description": "Extracted structured information.",
            "required": true,
            "items_type": "object"
          }
        ]
      },
      "tags": ["extraction"],
      "use_cases": ["Agent for extracting structured information from text."],
      "dependencies": []
    },
    "relevancy": {
      "agent_id": "relevancy",
      "name": "Relevancy Agent",
      "description": "Agent for assessing content relevancy using multiple rubrics.",
      "agent_class": "akd.agents.relevancy.MultiRubricRelevancyAgent", 
      "enabled": true,
      "input_schema": {
        "fields": [
          {
            "name": "query",
            "type": "string",
            "description": "Query to assess relevancy against.",
            "required": true
          },
          {
            "name": "content",
            "type": "string", 
            "description": "Content to assess for relevancy.",
            "required": true
          }
        ]
      },
      "output_schema": {
        "fields": [
          {
            "name": "relevancy_score",
            "type": "number",
            "description": "Relevancy score between 0 and 1.",
            "required": true
          },
          {
            "name": "reasoning",
            "type": "string",
            "description": "Reasoning for the relevancy assessment.",
            "required": true
          }
        ]
      },
      "tags": ["relevancy"],
      "use_cases": ["Agent for assessing content relevancy using multiple rubrics."],
      "dependencies": []
    }
  }
}